  "formulas": {
    "total_non_interest_revenues": "discount_revenue + net_card_fees + service_fees_and_other_revenue",
    "other_interest_income": "interest_and_dividends_on_investment_securities + deposits_with_banks_and_other",
    "total_interest_income": "interest_on_loans + other_interest_income",
    "total_interest_expense": "deposits_interest_expense + long_term_debt_and_other_interest_expense",
    "net_interest_income": "total_interest_income - total_interest_expense",
    "total_revenues_net_of_interest_expense": "total_non_interest_revenues + net_interest_income",
    "total_provisions_for_credit_losses": "card_member_receivables_provision + card_member_loans_provision + other_provisions",
    "total_revenues_net_of_interest_expense_after_provisions": "total_revenues_net_of_interest_expense - total_provisions_for_credit_losses",
    "total_expenses": "card_member_rewards + business_development + card_member_services + marketing + salaries_and_employee_benefits + other_net",
    "pretax_income": "total_revenues_net_of_interest_expense_after_provisions - total_expenses",
    "tax_provision": "pretax_income * tax_rate",
    "net_income": "pretax_income - tax_provision",
    "earnings_to_common": "net_income - participating_share_awards - preferred_dividends",
    "eps": "earnings_to_common / shares"
  },
