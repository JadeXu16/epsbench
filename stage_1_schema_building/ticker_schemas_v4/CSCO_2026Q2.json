    "gross_profit": "total_revenue - total_cogs",
    "total_opex": "rd + sales_marketing + general_administrative + amortization_intangibles + restructuring_charges",
    "operating_income": "gross_profit - total_opex",
    "total_interest_other": "interest_income - interest_expense - other_income_net",
    "pretax_income": "operating_income + total_interest_other",
    "net_income": "pretax_income - tax_provision",
    "eps": "net_income / shares",
    "tax_provision": "pretax_income * tax_rate"
  },
