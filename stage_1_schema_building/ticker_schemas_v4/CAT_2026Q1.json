  "formulas": {
    "total_revenue": "sales_of_machinery_energy_transportation + revenues_of_financial_products",
    "total_operating_costs": "cost_of_goods_sold + selling_general_and_administrative_expenses + research_and_development_expenses + interest_expense_of_financial_products + other_operating_income_expenses",
    "operating_profit": "total_revenue - total_operating_costs",
    "pretax_income": "operating_profit - interest_expense_excluding_financial_products + other_income_expense",
    "tax_provision": "pretax_income * tax_rate",
    "profit_of_consolidated_companies": "pretax_income - tax_provision",
    "profit_of_consolidated_and_affiliated_companies": "profit_of_consolidated_companies + equity_in_profit_of_unconsolidated_affiliates",
    "earnings_to_common": "profit_of_consolidated_and_affiliated_companies - noncontrolling_interest",
    "eps": "earnings_to_common / shares"
  },
  "prediction_schema": {
