  "formulas": {
    "total_interest_income": "interest_income_debt_securities + interest_income_loans_held_for_sale + interest_income_loans + interest_income_equity_securities + interest_income_other",
    "total_interest_expense": "interest_expense_deposits + interest_expense_short_term_borrowings + interest_expense_long_term_debt + interest_expense_other",
    "net_interest_income": "total_interest_income - total_interest_expense",
    "total_noninterest_income": "noninterest_income_deposit_and_lending_fees + noninterest_income_investment_advisory_fees + noninterest_income_commissions_and_brokerage_fees + noninterest_income_investment_banking_fees + noninterest_income_card_fees + noninterest_income_mortgage_banking + noninterest_income_net_gains_trading_securities + noninterest_income_other",
    "total_revenue": "net_interest_income + total_noninterest_income",
    "income_before_provision": "total_revenue - provision_for_credit_losses",
    "total_noninterest_expense": "personnel_expense + technology_telecommunications_equipment_expense + occupancy_expense + operating_losses + professional_and_outside_services_expense + advertising_and_promotion_expense + other_noninterest_expense",
    "income_before_tax": "income_before_provision - total_noninterest_expense",
    "tax_provision": "income_before_tax * tax_rate",
    "net_income_before_nci": "income_before_tax - tax_provision",
    "wells_fargo_net_income": "net_income_before_nci - noncontrolling_interest_income",
    "earnings_to_common": "wells_fargo_net_income - preferred_stock_dividends",
    "eps": "earnings_to_common / shares"
