  "formulas": {
    "total_revenue": "adv_and_sec_lending_revenue + performance_fees + technology_services_revenue + distribution_fees + advisory_other_revenue",
    "total_sales_asset": "distribution_servicing_costs + direct_fund_expense + sub_advisory_other",
    "total_expense": "employee_compensation + total_sales_asset + general_administration + other_operating_expenses",
    "operating_income": "total_revenue - total_expense",
    "pretax_income": "operating_income + non_operating_income",
    "tax_provision": "pretax_income * tax_rate",
    "net_income": "pretax_income - tax_provision",
    "earnings_to_common": "net_income - nci",
    "eps": "earnings_to_common / shares"
  },
  "prediction_schema": {
    "total_revenue_yoy": {
      "variable": "total_revenue",
      "type": "yoy",
      "constituents": [
        "adv_and_sec_lending_revenue",
        "performance_fees",
        "technology_services_revenue",
        "distribution_fees",
        "advisory_other_revenue"
      ],
      "description": "Total revenue YoY growth rate vs Q-4"
    },
    "employee_compensation_margin_delta_bps": {
      "variable": "employee_compensation",
      "type": "bps",
      "anchor": "total_revenue",
      "constituents": [
        "employee_compensation"
      ],
      "description": "Employee compensation as % of total revenue, delta vs Q-4"
    },
    "sales_asset_margin_delta_bps": {
      "variable": "total_sales_asset",
      "type": "bps",
      "anchor": "total_revenue",
      "constituents": [
        "distribution_servicing_costs",
        "direct_fund_expense",
        "sub_advisory_other"
      ],
      "description": "Sales, asset and account expense as % of total revenue, delta vs Q-4"
    },
    "general_administration_margin_delta_bps": {
      "variable": "general_administration",
      "type": "bps",
      "anchor": "total_revenue",
      "constituents": [
        "general_administration"
      ],
      "description": "General and administration expense as % of total revenue, delta vs Q-4"
    },
    "other_operating_expenses_yoy": {
      "variable": "other_operating_expenses",
      "type": "yoy",
      "constituents": [
        "other_operating_expenses"
      ],
