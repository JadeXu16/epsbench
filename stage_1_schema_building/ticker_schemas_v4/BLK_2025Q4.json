    },
    "non_operating_income_yoy": {
      "variable": "non_operating_income",
      "type": "yoy",
      "constituents": [
        "non_operating_income"
      ],
      "description": "Non-operating income YoY growth rate vs Q-4"
    },
    "nci_abs": {
      "variable": "nci",
      "type": "absolute",
      "default": -9.0,
      "description": "nci absolute dollar value for the target quarter (below-pretax line; predict directly, 0 if none expected)."
    },
    "shares_abs": {
      "variable": "shares",
      "type": "absolute",
      "default": 158.775,
      "references": {
        "last_q": 165.2,
        "ttm": 158.775,
        "q4": 157.0
      },
      "description": "shares: diluted weighted-average share count for the target quarter (predict the count directly; drifts slowly with buybacks/issuance)."
    },
    "tax_rate": {
      "variable": "tax_rate",
      "type": "rate_override",
      "constituents": [
        "tax_rate"
      ],
      "default": 0.215287,
      "references": {
        "last_q": 0.235353,
        "ttm": 0.215287,
        "q4": 0.2102
      },
      "description": "Effective GAAP tax rate for the target quarter (decimal, e.g. 0.14 = 14%; may be negative in a benefit quarter). Choose from the GAAP historical anchors provided; a discrete tax item can push it far from any of them."
