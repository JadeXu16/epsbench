    "pretax_income": "operating_income - non_operating_expense",
    "tax_provision": "pretax_income * tax_rate",
    "net_income": "pretax_income - tax_provision",
    "earnings_to_common": "net_income - noncontrolling_interest",
    "eps": "earnings_to_common / shares"
